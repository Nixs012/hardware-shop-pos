rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }

    match /staff/{staffId} {
      allow read: if (isAuthenticated() && request.auth.uid == staffId) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Cost data for products is strictly restricted to admins only
    match /product_costs/{productId} {
      allow read, write: if isAdmin();
    }

    // Sales are immutable. Cashiers can only read their own sales without cost data.
    match /sales/{saleId} {
      allow read: if (isAuthenticated() && resource.data.staff_id == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Cost data snapshots for sales are strictly restricted to admins only
    match /sales_costs/{saleId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Credit repayments are tracked in customer_payments. Admin-only read; cashiers create-only.
    match /customer_payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Operating expenses: admin-only read and write
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
