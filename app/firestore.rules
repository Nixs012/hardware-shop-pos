rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getShopId() {
      return getUserData().shop_id;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin' && getUserData().active == true;
    }

    function isCashier() {
      return isAuthenticated() && getUserData().role == 'cashier' && getUserData().active == true;
    }

    function belongsToShop(shopId) {
      return isAuthenticated() && getShopId() == shopId && getUserData().active == true;
    }

    // Top-level user lookup document
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && (
        // Shop admin creating a staff user in their own shop
        (isAdmin() && belongsToShop(request.resource.data.shop_id)) ||
        // User creating their own account:
        (request.auth.uid == uid && (
          // 1. Initial shop owner creating a new shop (shop doc does not yet exist)
          (request.resource.data.role == 'admin' &&
           !exists(/databases/$(database)/documents/shops/$(request.resource.data.shop_id))) ||
          // 2. Cashier joining with valid join code matching the shop
          (request.resource.data.role == 'cashier' &&
           request.resource.data.join_code is string &&
           get(/databases/$(database)/documents/joinCodes/$(request.resource.data.join_code)).data.shopId == request.resource.data.shop_id)
        ))
      );
      allow update: if isAuthenticated() && (
        // Admin can update users in their shop
        (isAdmin() && belongsToShop(resource.data.shop_id)) ||
        // User can update their own profile, but cannot escalate role or change shop_id
        (request.auth.uid == uid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.shop_id == resource.data.shop_id)
      );
      allow delete: if isAdmin() && belongsToShop(resource.data.shop_id);
    }

    // Top-level joinCodes collection:
    // Single field: shopId.
    // Readable by get only, list disabled to prevent enumeration.
    match /joinCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['shopId']) &&
        request.resource.data.shopId is string &&
        (
          // Admin regenerating code for existing shop
          (exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId)) &&
           isAdmin() && belongsToShop(request.resource.data.shopId)) ||
          // Initial shop creation (shop doc does not exist yet before batch commits)
          (!exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId)))
        );
      allow delete: if isAdmin() && belongsToShop(resource.data.shopId);
      allow update: if false;
    }

    // Shops collection
    match /shops/{shopId} {
      // Restrict reads to members of that shop. No public list or read.
      allow list: if false;
      allow get: if isAuthenticated() && belongsToShop(shopId);
      allow create: if isAuthenticated() && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isAdmin() && belongsToShop(shopId);
      allow delete: if false;

      // Staff subcollection
      match /staff/{staffId} {
        allow read: if isAuthenticated() && (request.auth.uid == staffId || belongsToShop(shopId));
        allow create: if isAuthenticated() && (
          // Admin of this shop can create staff
          (isAdmin() && belongsToShop(shopId)) ||
          // Shop owner during initial shop creation (shop does not exist yet before batch commits)
          (!exists(/databases/$(database)/documents/shops/$(shopId)) && request.auth.uid == staffId) ||
          // Cashier joining with valid join code matching this shop
          (request.auth.uid == staffId &&
           request.resource.data.role == 'cashier' &&
           request.resource.data.join_code is string &&
           get(/databases/$(database)/documents/joinCodes/$(request.resource.data.join_code)).data.shopId == shopId)
        );
        allow update: if isAdmin() && belongsToShop(shopId);
        allow delete: if false;
      }

      // Products
      match /products/{productId} {
        allow read: if belongsToShop(shopId);
        allow create, delete: if isAdmin() && belongsToShop(shopId);
        allow update: if belongsToShop(shopId) && (
          isAdmin() ||
          (isCashier() && request.resource.data.keys().hasOnly(resource.data.keys()) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity_on_hand']) &&
           request.resource.data['quantity_on_hand'] is number)
        );
      }

      // Product costs (Admin only)
      match /product_costs/{productId} {
        allow read, write: if isAdmin() && belongsToShop(shopId);
      }

      // Sales
      match /sales/{saleId} {
        allow read: if belongsToShop(shopId) && (isAdmin() || resource.data.staff_id == request.auth.uid);
        allow create: if belongsToShop(shopId) && isAuthenticated();
        allow update, delete: if false;
      }

      // Sales costs (Admin only)
      match /sales_costs/{saleId} {
        allow read: if isAdmin() && belongsToShop(shopId);
        allow create: if belongsToShop(shopId) && isAuthenticated();
        allow update, delete: if false;
      }

      // Customer payments
      match /customer_payments/{paymentId} {
        allow read: if isAdmin() && belongsToShop(shopId);
        allow create: if belongsToShop(shopId) && isAuthenticated();
        allow update, delete: if false;
      }

      // Expenses
      match /expenses/{expenseId} {
        allow read, write: if isAdmin() && belongsToShop(shopId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
